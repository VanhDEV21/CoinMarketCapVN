{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "outDir": "dist", 
    "types": ["node", "telegraf"],
    "sourceMap": true,
    "strict": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "lib": ["es2021", "dom"]
  },
  "include": ["apps/be/**/*.ts", "apps/fe/**/*"],
  "exclude": ["node_modules"]
}
